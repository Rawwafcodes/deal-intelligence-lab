# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git and never committed.
#
# LOCAL DEVELOPMENT needs only the Anthropic key below - every other setting
# has a local default. The HOSTED section is what the Railway web and worker
# services get as environment variables (set in Railway, never committed).

# --- AI ------------------------------------------------------------------
# Your Anthropic API key (a workspace-scoped key). https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Which Claude model to use.
ANTHROPIC_MODEL=claude-opus-5

# --- HOSTED (staging / pilot) - leave unset locally -----------------------
# Environment name, used to tag errors (e.g. staging, pilot).
# DEAL_LAB_ENVIRONMENT=staging

# Database: the full connection URL from Neon (includes password and
# sslmode=require). Overrides the local DEAL_LAB_PG_* settings.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Sign-in: hosted builds use Clerk. The image defaults to clerk mode.
# DEAL_LAB_AUTH_MODE=clerk
# DEAL_LAB_AUTH_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
# DEAL_LAB_AUTH_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# DEAL_LAB_AUTH_AUTHORIZED_PARTIES=https://your-staging-domain
# DEAL_LAB_ALLOWED_ORIGINS=https://your-staging-domain
# Build-time only (public, baked into the React build):
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Document storage: Cloudflare R2 (S3-compatible), private bucket.
# DEAL_LAB_STORAGE=object
# DEAL_LAB_S3_BUCKET=deal-lab-staging
# DEAL_LAB_S3_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
# DEAL_LAB_S3_PREFIX=staging
# AWS_ACCESS_KEY_ID=         # R2 API token access key
# AWS_SECRET_ACCESS_KEY=     # R2 API token secret

# Background work: the web service runs no worker; the worker service does.
# DEAL_LAB_RUN_WORKER=0      # web service only

# Error tracking (optional): Sentry project DSN.
# SENTRY_DSN=

# --- LOCAL overrides (rarely needed) -------------------------------------
# DEAL_LAB_PG_HOST, DEAL_LAB_PG_PORT, DEAL_LAB_PG_DBNAME, DEAL_LAB_PG_USER
# DEAL_LAB_DATA_DIR=~/DealLabData
