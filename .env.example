# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git and never committed.

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which Claude model to use for the AI connection test.
# Leave as-is unless you have a specific reason to change it.
ANTHROPIC_MODEL=claude-opus-5
